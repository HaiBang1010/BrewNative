{
  "expo": {
    "name": "Brew",
    "slug": "brew",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "brew",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#C67C4E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brew.reactnative"
    },
    "android": {
      "package": "com.brew.reactnative",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#C67C4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.865915099764-6eb7d4p8e7599kda20f8fr3n6d9s213e"
        }
      ],
      "expo-router",
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C67C4E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Brew cần truy cập ảnh để bạn chọn ảnh cho món trong menu.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "./plugins/with-android-theme",
        {
          "accentColor": "#C67C4E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f0b9bf52-8cce-492c-ba01-860db8c86b32"
      }
    },
    "owner": "haibang1010"
  }
}

# Copy to .env: cp .env.example .env
# docker-compose.yml reads the DB_* values from this file too.

NODE_ENV=development
PORT=3100
# Use the Mac's LAN IP so uploaded images load on a real phone, e.g. http://192.168.0.13:3100
PUBLIC_URL=http://localhost:3100

DB_HOST=localhost
DB_PORT=5440
DB_USER=brew
DB_PASSWORD=brew
DB_NAME=brew

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google Sign-In: OAuth client IDs from Google Cloud Console, comma-separated
# (Web client ID, iOS client ID, Android client ID). Empty = Google login disabled.
GOOGLE_CLIENT_IDS=
# Web client secret. Not needed to verify ID tokens; only for server-side auth code exchange.
GOOGLE_CLIENT_SECRET=

# Optional: only needed if "Enhanced push security" is enabled in the Expo dashboard.
EXPO_ACCESS_TOKEN=

ORDER_PAYMENT_TIMEOUT_MINUTES=15

# Used by `npm run seed` only.
SEED_ADMIN_EMAIL=admin@brew.local
SEED_ADMIN_PASSWORD=Admin@12345

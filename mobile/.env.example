# Copy to .env: cp .env.example .env
# EXPO_PUBLIC_* values are embedded in the app bundle and readable by anyone who
# has the app. Never put secrets here (no Stripe sk_/whsec_, no JWT secret).

# Backend API. Use the Mac's LAN IP (ipconfig getifaddr en0), not localhost,
# so a real phone on the same Wi-Fi can reach it.
EXPO_PUBLIC_API_URL=http://192.168.0.13:3100/api

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Stripe publishable key (pk_test_...): Dashboard → Developers → API keys.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
